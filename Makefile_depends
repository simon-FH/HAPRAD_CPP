# Header dependencies are generated by the compiler (-MMD -MP) in the .cxx rule
# in Makefile. This used to shell out to `makedepend`, which is not installed on
# current distributions; the failure was swallowed, an empty .d file was written
# for every source and then included, so editing a header rebuilt nothing.

ifeq (,$(filter clean distclean,$(MAKECMDGOALS)))
-include $(SRC_DEP)
endif
